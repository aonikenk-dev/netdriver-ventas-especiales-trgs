# backend/.env
# Prototipo: estas variables aun no se usan (DB y WS estan mockeados).
# Se completan cuando se conecte la DB real y el WS de TRGS.

# SQL Server
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

# TRGS Web Service
TRGS_URL=https://www.trgs.com.ar:443/service/index.php?wsdl
TRGS_URL_TESTING=http://testingvdc.trgs.com.ar/service/index.php?wsdl
TRGS_USW_ID=000005
TRGS_USW_PASSWORD=
TRGS_USW_HASH=
TRGS_HTTP_USER=
TRGS_HTTP_PASS=
TRGS_ID_EMPRESA=5452

# PDFs locales
PDF_DIR=/ruta/al/directorio/pdfs

# App
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Mock
USE_MOCKS=true
