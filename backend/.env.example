# backend/.env

# ─── Modo ────────────────────────────────────────────────────────────────────
# true  → usa datos en memoria (sin DB, arranque instantaneo para UI dev)
# false → conecta a SQL Server usando las variables DB_* de abajo
USE_MOCKS=false

# ─── SQL Server ──────────────────────────────────────────────────────────────
# Base LOCAL de prueba (Docker):
#   docker run -e "ACCEPT_EULA=Y" -e "SA_PASSWORD=Dev@1234!" \
#     -p 1433:1433 --name sqlserver -d mcr.microsoft.com/mssql/server:2022-latest
#   Luego ejecutar backend/schema.sql (incluye CREATE DATABASE + seed data)
#
# Base de PRODUCCION: completar con los datos reales del cliente.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=netdriver_trgs
DB_USER=sa
DB_PASSWORD=Dev@1234!

# ─── TRGS Web Service (SOAP) ─────────────────────────────────────────────────
TRGS_URL=https://servicehabitualistas.suats.com.ar/service/index.php?wsdl
TRGS_USW_ID=000005
TRGS_USW_PASSWORD=
TRGS_USW_HASH=
TRGS_ID_EMPRESA=5452
# Credenciales HTTP Basic Auth (si el servidor las requiere)
TRGS_HTTP_USER=
TRGS_HTTP_PASS=

# ─── PDFs locales ────────────────────────────────────────────────────────────
PDF_DIR=/ruta/al/directorio/pdfs

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173
